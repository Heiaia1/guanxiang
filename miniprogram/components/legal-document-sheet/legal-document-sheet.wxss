.legal-overlay {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(5, 9, 10, 0.82);
  animation: legal-fade-in 180ms ease both;
}

.legal-sheet {
  width: 100%;
  height: 92vh;
  overflow: hidden;
  border: 1rpx solid rgba(179, 154, 101, 0.22);
  border-bottom: 0;
  border-radius: 34rpx 34rpx 0 0;
  background: #11191a;
  box-shadow: 0 -24rpx 80rpx rgba(0, 0, 0, 0.34);
  animation: legal-rise 240ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.legal-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 126rpx;
  padding: 24rpx 26rpx 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(234, 229, 216, 0.08);
  box-sizing: border-box;
}

.legal-sheet__eyebrow {
  color: rgba(179, 154, 101, 0.62);
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.legal-sheet__title {
  margin-top: 8rpx;
  color: #eee6d7;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 31rpx;
}

.legal-sheet__close {
  display: flex;
  flex: 0 0 66rpx;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border: 1rpx solid rgba(234, 229, 216, 0.12);
  border-radius: 50%;
  color: rgba(234, 229, 216, 0.62);
  font-size: 40rpx;
  line-height: 1;
}

.legal-scroll {
  height: calc(92vh - 126rpx);
  padding: 28rpx 30rpx 0;
  box-sizing: border-box;
}

.legal-meta {
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(234, 229, 216, 0.08);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.025);
  color: rgba(234, 229, 216, 0.43);
  font-size: 19rpx;
  line-height: 1.8;
}

.legal-summary {
  margin: 24rpx 4rpx 34rpx;
  color: rgba(203, 213, 208, 0.72);
  font-size: 22rpx;
  line-height: 1.72;
}

.legal-section {
  margin-bottom: 38rpx;
}

.legal-section__title {
  margin-bottom: 18rpx;
  color: #d7c9ab;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.legal-section__paragraph {
  margin-bottom: 16rpx;
  color: rgba(234, 229, 216, 0.62);
  font-size: 22rpx;
  line-height: 1.82;
  text-align: justify;
}

.legal-section__bullet {
  display: flex;
  align-items: flex-start;
  margin: 0 0 13rpx 2rpx;
  color: rgba(234, 229, 216, 0.58);
  font-size: 21rpx;
  line-height: 1.76;
}

.legal-section__bullet text {
  flex: 1;
}

.legal-section__dot {
  flex: 0 0 7rpx;
  width: 7rpx;
  height: 7rpx;
  margin: 16rpx 15rpx 0 0;
  border-radius: 50%;
  background: rgba(102, 132, 122, 0.88);
}

.legal-end {
  padding: 18rpx 0 34rpx;
  color: rgba(234, 229, 216, 0.24);
  font-size: 18rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

.motion-off,
.motion-off .legal-sheet {
  animation: none !important;
}

@keyframes legal-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes legal-rise {
  from { transform: translateY(48rpx); }
  to { transform: translateY(0); }
}

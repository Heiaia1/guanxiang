.support-page { min-height: 100vh; }
.support-intro { margin-top: 20rpx; color: rgba(234, 229, 216, 0.55); font-size: 24rpx; line-height: 1.75; }
.support-grid { display: grid; gap: 18rpx; margin-top: 34rpx; }
.support-card { padding: 28rpx; }
.support-card__mark { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border: 1rpx solid rgba(179, 154, 101, 0.4); border-radius: 50%; color: #c0a76d; font-family: "STKaiti", "KaiTi", serif; }
.support-card__title { margin-top: 18rpx; color: #ece4d5; font-size: 30rpx; }
.support-card__text { margin: 10rpx 0 22rpx; color: rgba(234, 229, 216, 0.47); font-size: 22rpx; line-height: 1.65; }
.site-link { width: 100%; margin-top: 26rpx; padding: 24rpx; color: #a8c1b7; font-size: 22rpx; }
.support-note { margin-top: 24rpx; color: rgba(234, 229, 216, 0.3); font-size: 19rpx; text-align: center; }

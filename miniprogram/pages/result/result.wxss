page {
  overflow: hidden;
}

.result-page,
.result-scroll {
  height: 100vh;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #101415;
}

.loading-state__ring {
  width: 92rpx;
  height: 92rpx;
  border: 2rpx solid rgba(179, 154, 101, 0.18);
  border-top-color: #b39a65;
  border-radius: 50%;
  animation: spin 1.1s linear infinite;
}

.loading-state__text {
  margin-top: 28rpx;
  color: rgba(234, 229, 216, 0.5);
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.error-view {
  margin-top: 18vh;
  padding: 48rpx 34rpx;
  text-align: center;
}

.error-view__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto;
  border: 1rpx solid rgba(179, 154, 101, 0.4);
  border-radius: 50%;
  color: #baa16a;
}

.error-view__title {
  margin-top: 26rpx;
  color: #ece5d7;
  font-size: 34rpx;
  font-weight: 600;
}

.error-view__text {
  margin: 18rpx 0 34rpx;
  color: rgba(234, 229, 216, 0.56);
  line-height: 1.7;
}

.error-view .ghost-button,
.blocked-view .ghost-button {
  margin-top: 14rpx;
}

.blocked-view {
  position: relative;
  min-height: 100vh;
  padding: calc(70rpx + env(safe-area-inset-top)) 32rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 10%, rgba(154, 79, 68, 0.16), transparent 32%),
    #101415;
}

.blocked-view__halo {
  position: absolute;
  top: -180rpx;
  left: 50%;
  width: 540rpx;
  height: 540rpx;
  border: 1rpx solid rgba(154, 79, 68, 0.13);
  border-radius: 50%;
  transform: translateX(-50%);
}

.blocked-view__content {
  position: relative;
  z-index: 2;
  max-width: 680rpx;
  margin: 0 auto;
  text-align: center;
}

.blocked-view__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
  margin: 0 auto 28rpx;
  border: 2rpx solid rgba(154, 79, 68, 0.54);
  border-radius: 50%;
  color: #d39489;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 42rpx;
  background: rgba(154, 79, 68, 0.08);
}

.blocked-view__eyebrow {
  color: #c78579;
  font-size: 21rpx;
  letter-spacing: 6rpx;
}

.blocked-view__title {
  margin-top: 16rpx;
  color: #efe6d8;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 46rpx;
  line-height: 1.35;
}

.blocked-view__message {
  margin-top: 24rpx;
  color: rgba(234, 229, 216, 0.65);
  line-height: 1.75;
}

.blocked-view__guidance {
  margin: 38rpx 0 34rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(154, 79, 68, 0.25);
  border-radius: 24rpx;
  text-align: left;
  background: rgba(154, 79, 68, 0.06);
}

.blocked-view__guidance-title {
  margin-bottom: 20rpx;
  color: #dfd6c7;
  font-weight: 600;
}

.blocked-view__guidance-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  margin-top: 14rpx;
  color: rgba(234, 229, 216, 0.58);
  font-size: 23rpx;
  line-height: 1.55;
}

.blocked-view__step {
  display: flex;
  flex: 0 0 34rpx;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #ce958a;
  font-style: normal;
  font-size: 18rpx;
  background: rgba(154, 79, 68, 0.16);
}

.blocked-view__note {
  margin-top: 24rpx;
  color: rgba(234, 229, 216, 0.3);
  font-size: 20rpx;
  line-height: 1.5;
}

.result-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 740rpx;
  padding: 70rpx 32rpx 62rpx;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(102, 132, 122, 0.17), transparent 70%),
    #101718;
}

.scene-layer {
  position: absolute;
  z-index: 0;
  right: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
}

.scene-layer--upper {
  top: 0;
  height: 62%;
}

.scene-layer--lower {
  bottom: 0;
  height: 42%;
}

.scene-upper__mark,
.scene-upper__trace,
.scene-lower__shape,
.scene-lower__trace {
  position: absolute;
}

.scene-upper__mark {
  top: 76rpx;
  right: 8%;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  opacity: 0.34;
  animation: scene-drift 8s ease-in-out infinite;
}

.scene-upper__trace {
  top: 24%;
  left: 7%;
  width: 86%;
  height: 150rpx;
  opacity: 0.28;
}

.scene-lower__shape {
  right: -10%;
  bottom: -90rpx;
  left: -10%;
  height: 250rpx;
  opacity: 0.3;
}

.scene-lower__trace {
  right: 10%;
  bottom: 68rpx;
  left: 10%;
  height: 70rpx;
  opacity: 0.32;
  animation: scene-breathe 6s ease-in-out infinite;
}

.scene-upper--qian .scene-layer--upper {
  background: radial-gradient(circle at 72% 20%, rgba(218, 193, 131, 0.22), transparent 38%);
}
.scene-upper--qian .scene-upper__mark {
  border: 1rpx solid rgba(220, 198, 142, 0.48);
  box-shadow: 0 0 90rpx rgba(210, 183, 115, 0.2);
}

.scene-upper--kun .scene-layer--upper {
  background: linear-gradient(180deg, rgba(126, 113, 88, 0.2), transparent 72%);
}
.scene-upper--kun .scene-upper__mark {
  top: 132rpx;
  border-radius: 48% 52% 12% 10%;
  background: linear-gradient(155deg, transparent 46%, rgba(148, 132, 101, 0.34) 47%);
}

.scene-upper--zhen .scene-layer--upper {
  background: radial-gradient(circle at 70% 14%, rgba(150, 115, 82, 0.2), transparent 42%);
}
.scene-upper--zhen .scene-upper__trace {
  width: 220rpx;
  height: 280rpx;
  border-left: 5rpx solid rgba(205, 166, 100, 0.5);
  transform: skewX(-24deg) rotate(18deg);
  box-shadow: -24rpx 34rpx 0 -20rpx rgba(205, 166, 100, 0.35);
}

.scene-upper--xun .scene-layer--upper {
  background: repeating-linear-gradient(168deg, transparent 0 34rpx, rgba(122, 158, 145, 0.09) 36rpx 38rpx);
}
.scene-upper--xun .scene-upper__trace {
  border-top: 2rpx solid rgba(145, 176, 163, 0.42);
  border-radius: 50%;
  transform: rotate(-7deg);
}

.scene-upper--kan .scene-layer--upper {
  background: radial-gradient(ellipse at 66% 18%, rgba(64, 99, 119, 0.3), transparent 48%);
}
.scene-upper--kan .scene-upper__trace {
  background: repeating-linear-gradient(105deg, transparent 0 28rpx, rgba(119, 157, 177, 0.22) 30rpx 32rpx);
  transform: rotate(-7deg);
}

.scene-upper--li .scene-layer--upper {
  background: radial-gradient(circle at 72% 20%, rgba(189, 93, 69, 0.28), transparent 38%);
}
.scene-upper--li .scene-upper__mark {
  background: radial-gradient(circle, rgba(224, 151, 103, 0.34), rgba(168, 72, 56, 0.08) 58%, transparent 64%);
  box-shadow: 0 0 100rpx rgba(181, 82, 60, 0.22);
}

.scene-upper--gen .scene-layer--upper {
  background: linear-gradient(180deg, rgba(105, 112, 103, 0.17), transparent 72%);
}
.scene-upper--gen .scene-upper__mark {
  top: 166rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, transparent 49%, rgba(135, 143, 132, 0.34) 50%);
  transform: rotate(45deg);
  animation: none;
}

.scene-upper--dui .scene-layer--upper {
  background: radial-gradient(circle at 73% 19%, rgba(181, 192, 196, 0.2), transparent 38%);
}
.scene-upper--dui .scene-upper__mark {
  width: 190rpx;
  height: 190rpx;
  border: 1rpx solid rgba(210, 216, 211, 0.44);
  box-shadow: inset 34rpx -18rpx 0 rgba(16, 23, 24, 0.38);
}

.scene-lower--qian .scene-lower__trace {
  border-top: 2rpx solid rgba(199, 173, 109, 0.34);
  box-shadow: 0 -18rpx 45rpx rgba(191, 160, 91, 0.12);
}

.scene-lower--kun .scene-lower__shape {
  border-top: 1rpx solid rgba(148, 132, 101, 0.32);
  border-radius: 50% 50% 0 0;
  background: linear-gradient(180deg, rgba(117, 103, 79, 0.2), transparent 70%);
}

.scene-lower--zhen .scene-lower__trace {
  border: 2rpx solid rgba(171, 119, 82, 0.34);
  border-radius: 50%;
  transform: scaleY(0.28);
  animation: none;
}

.scene-lower--xun .scene-lower__trace {
  border-top: 2rpx solid rgba(125, 160, 145, 0.34);
  border-radius: 50%;
  transform: skewX(-28deg);
  animation: none;
}

.scene-lower--kan .scene-lower__shape,
.scene-lower--dui .scene-lower__shape {
  border-top: 2rpx solid rgba(105, 147, 166, 0.32);
  border-radius: 50% 50% 0 0;
  background: repeating-radial-gradient(ellipse at 50% 0, transparent 0 27rpx, rgba(91, 132, 151, 0.09) 29rpx 31rpx);
}

.scene-lower--li .scene-lower__trace {
  background: radial-gradient(circle at 24% 70%, rgba(193, 91, 66, 0.42) 0 5rpx, transparent 7rpx),
    radial-gradient(circle at 68% 34%, rgba(211, 137, 83, 0.36) 0 4rpx, transparent 6rpx);
}

.scene-lower--gen .scene-lower__shape {
  right: 10%;
  left: 10%;
  border-radius: 20rpx;
  background: linear-gradient(145deg, transparent 49%, rgba(117, 125, 116, 0.28) 50%);
  transform: rotate(3deg);
}

.scene-lower--dui .scene-lower__trace {
  border-top: 1rpx solid rgba(190, 198, 196, 0.35);
  box-shadow: 0 -10rpx 35rpx rgba(184, 194, 191, 0.1);
}

.result-hero__pinyin,
.result-hero .keyword-row,
.result-hero__trigrams {
  position: relative;
  z-index: 2;
}

@keyframes scene-drift {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50% { transform: translate3d(-18rpx, 12rpx, 0); }
}

@keyframes scene-breathe {
  0%, 100% { opacity: 0.22; transform: scaleX(0.94); }
  50% { opacity: 0.42; transform: scaleX(1.04); }
}

.result-hero__glow {
  position: absolute;
  top: 82rpx;
  left: 50%;
  width: 430rpx;
  height: 430rpx;
  border: 1rpx solid rgba(179, 154, 101, 0.13);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(179, 154, 101, 0.1), transparent 65%);
  transform: translateX(-50%);
}

.result-hero__meta {
  position: relative;
  color: rgba(234, 229, 216, 0.42);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.result-hero__symbol {
  position: absolute;
  top: 70rpx;
  right: 40rpx;
  color: rgba(179, 154, 101, 0.14);
  font-size: 110rpx;
}

.result-hero hexagram-symbol {
  position: relative;
  margin-top: 66rpx;
}

.result-hero__name {
  position: relative;
  margin-top: 36rpx;
  color: #f2eadb;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 78rpx;
  letter-spacing: 10rpx;
  text-indent: 10rpx;
}

.result-hero__pinyin {
  margin-top: 4rpx;
  color: rgba(234, 229, 216, 0.34);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.keyword-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 24rpx;
}

.keyword {
  padding: 9rpx 18rpx;
  border: 1rpx solid rgba(102, 132, 122, 0.35);
  border-radius: 22rpx;
  color: #aebeb7;
  font-size: 20rpx;
  background: rgba(102, 132, 122, 0.08);
}

.result-hero__trigrams {
  margin-top: 22rpx;
  color: rgba(179, 154, 101, 0.62);
  font-size: 21rpx;
  letter-spacing: 4rpx;
}

.result-body {
  position: relative;
  z-index: 2;
  margin-top: -28rpx;
  padding: 0 30rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #101415;
}

.summary-card {
  padding: 34rpx 30rpx;
}

.summary-card__eyebrow {
  color: #b39a65;
  font-size: 20rpx;
  letter-spacing: 5rpx;
}

.summary-card__text {
  margin-top: 16rpx;
  color: #e4ddcf;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 32rpx;
  line-height: 1.75;
}

.reflection-card {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 25rpx;
  border: 1rpx solid rgba(102, 132, 122, 0.28);
  border-radius: 22rpx;
  background: rgba(102, 132, 122, 0.09);
}

.reflection-card__mark {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(102, 132, 122, 0.45);
  border-radius: 50%;
  color: #a7bab2;
}

.reflection-card__title {
  color: #dfe4df;
  font-size: 24rpx;
  font-weight: 600;
}

.reflection-card__text {
  margin-top: 8rpx;
  color: rgba(234, 229, 216, 0.55);
  font-size: 23rpx;
  line-height: 1.6;
}

.insight-list {
  overflow: hidden;
  border: 1rpx solid rgba(234, 229, 216, 0.09);
  border-radius: 26rpx;
  background: rgba(26, 34, 34, 0.72);
}

.insight {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 25rpx;
  border-bottom: 1rpx solid rgba(234, 229, 216, 0.07);
}

.insight:last-child {
  border-bottom: 0;
}

.insight--risk {
  background: rgba(154, 79, 68, 0.035);
}

.insight__index {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(179, 154, 101, 0.38);
  border-radius: 50%;
  color: #baa16b;
  font-size: 21rpx;
}

.insight__index--green {
  color: #9fb3ab;
  border-color: rgba(102, 132, 122, 0.52);
}

.insight__index--red {
  color: #d09287;
  border-color: rgba(154, 79, 68, 0.52);
}

.insight__title {
  color: #e7e0d2;
  font-size: 26rpx;
  font-weight: 600;
}

.insight__text {
  margin-top: 9rpx;
  color: rgba(234, 229, 216, 0.56);
  font-size: 23rpx;
  line-height: 1.65;
}

.action-list {
  position: relative;
  padding: 10rpx 0;
}

.action-list::before {
  position: absolute;
  top: 36rpx;
  bottom: 36rpx;
  left: 126rpx;
  width: 1rpx;
  background: rgba(179, 154, 101, 0.18);
  content: "";
}

.action-item {
  position: relative;
  display: grid;
  grid-template-columns: 96rpx 20rpx 1fr;
  gap: 20rpx;
  align-items: start;
  min-height: 94rpx;
  padding: 16rpx 0;
}

.action-item__time {
  padding-top: 4rpx;
  color: rgba(179, 154, 101, 0.76);
  font-size: 21rpx;
  text-align: right;
}

.action-item__dot {
  position: relative;
  z-index: 2;
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border: 3rpx solid #101415;
  border-radius: 50%;
  background: #b39a65;
  box-shadow: 0 0 0 1rpx rgba(179, 154, 101, 0.35);
}

.action-item__text {
  color: rgba(234, 229, 216, 0.68);
  font-size: 24rpx;
  line-height: 1.65;
}

.section-link {
  color: #9fb2aa;
  font-size: 21rpx;
}

.culture-card {
  padding: 32rpx 28rpx;
}

.culture-card__source {
  color: rgba(179, 154, 101, 0.65);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.culture-card__traditional {
  margin-top: 16rpx;
  color: #e8e0d1;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 29rpx;
  line-height: 1.75;
}

.culture-card__divider {
  width: 52rpx;
  height: 2rpx;
  margin: 23rpx 0;
  background: rgba(179, 154, 101, 0.42);
}

.culture-card__plain {
  color: rgba(234, 229, 216, 0.52);
  font-size: 23rpx;
  line-height: 1.75;
}

.result-actions {
  margin-top: 42rpx;
}

.result-actions__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.result-actions__row .secondary-button {
  min-height: 84rpx;
  padding: 0 16rpx;
  font-size: 23rpx;
}

.share-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 76rpx;
  margin-top: 12rpx;
  color: rgba(234, 229, 216, 0.52);
  font-size: 22rpx;
}

.not-save-button {
  width: 100%;
  min-height: 76rpx;
  margin-top: 8rpx;
  color: rgba(224, 178, 166, 0.72);
  font-size: 22rpx;
  background: transparent;
}

.not-save-button[disabled] {
  opacity: 0.42;
}

.disclaimer {
  margin-top: 36rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  color: rgba(234, 229, 216, 0.34);
  font-size: 20rpx;
  line-height: 1.65;
  text-align: center;
  background: rgba(255, 255, 255, 0.018);
}

.home-link,
.history-link {
  width: 100%;
  padding: 26rpx;
  color: rgba(234, 229, 216, 0.55);
  font-size: 23rpx;
}

.history-link {
  margin-top: -14rpx;
  color: rgba(102, 132, 122, 0.9);
}

.share-canvas {
  position: fixed;
  top: 0;
  left: -2000rpx;
  width: 600px;
  height: 800px;
  pointer-events: none;
}

.share-preview {
  position: fixed;
  z-index: 90;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 38rpx;
  background: rgba(4, 7, 8, 0.88);
  backdrop-filter: blur(14rpx);
}

.share-preview__sheet {
  width: 100%;
  max-width: 620rpx;
  text-align: center;
}

.share-preview__image {
  width: 100%;
  max-height: 70vh;
  border: 1rpx solid rgba(179, 154, 101, 0.3);
  border-radius: 24rpx;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.45);
}

.share-preview__hint {
  margin-top: 18rpx;
  color: rgba(234, 229, 216, 0.38);
  font-size: 20rpx;
}

.share-preview__button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  margin-top: 22rpx;
  border-radius: 43rpx;
  color: #111718;
  font-size: 25rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #d7c18a, #a98d55);
}

.share-preview__close {
  width: 100%;
  padding: 22rpx;
  color: rgba(234, 229, 216, 0.48);
  font-size: 22rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

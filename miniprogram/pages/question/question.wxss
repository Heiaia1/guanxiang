.editor {
  margin-top: 42rpx;
  padding: 28rpx 28rpx 22rpx;
  transition: border-color 180ms ease;
}

.editor--error {
  border-color: rgba(154, 79, 68, 0.66);
}

.editor__textarea {
  width: 100%;
  min-height: 260rpx;
  max-height: 440rpx;
  color: #eee7d9;
  font-size: 31rpx;
  line-height: 1.7;
}

.editor__placeholder {
  color: rgba(234, 229, 216, 0.26);
}

.editor__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(234, 229, 216, 0.08);
}

.editor__privacy {
  color: rgba(102, 132, 122, 0.9);
  font-size: 21rpx;
}

.editor__count {
  color: rgba(234, 229, 216, 0.36);
  font-size: 21rpx;
}

.editor__count--warn {
  color: #c99c68;
}

.error-text {
  margin: 13rpx 8rpx 0;
  color: #d89c91;
  font-size: 23rpx;
}

.privacy-note {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(102, 132, 122, 0.09);
}

.privacy-note__icon {
  display: flex;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid rgba(102, 132, 122, 0.52);
  border-radius: 50%;
  color: #92a89f;
  font-size: 21rpx;
}

.privacy-note__title {
  color: rgba(234, 229, 216, 0.8);
  font-size: 24rpx;
}

.privacy-note__text {
  margin-top: 6rpx;
  color: rgba(234, 229, 216, 0.45);
  font-size: 21rpx;
  line-height: 1.5;
}

.examples-title {
  margin-top: 38rpx;
  color: rgba(234, 229, 216, 0.5);
  font-size: 23rpx;
}

.examples {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.example-chip {
  padding: 17rpx 22rpx;
  border: 1rpx solid rgba(179, 154, 101, 0.16);
  border-radius: 30rpx;
  color: rgba(234, 229, 216, 0.58);
  font-size: 21rpx;
  background: rgba(179, 154, 101, 0.05);
}

.submit-button {
  margin-top: 52rpx;
}

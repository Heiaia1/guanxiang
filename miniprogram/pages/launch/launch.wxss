page {
  overflow: hidden;
}

.launch {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 42%, rgba(102, 132, 122, 0.2), transparent 32%),
    linear-gradient(160deg, #0d1213, #11191a 52%, #0b0f10);
}

.mist {
  position: absolute;
  width: 780rpx;
  height: 280rpx;
  border-radius: 50%;
  opacity: 0.38;
  filter: blur(46rpx);
  background: rgba(102, 132, 122, 0.16);
}

.mist--one {
  top: 12%;
  left: -45%;
  animation: mist-one 8s ease-in-out infinite;
}

.mist--two {
  right: -45%;
  bottom: 14%;
  animation: mist-two 10s ease-in-out infinite;
}

.ritual {
  position: absolute;
  top: 28%;
  left: 50%;
  width: 360rpx;
  height: 360rpx;
  transform: translateX(-50%);
}

.light-seed {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ddc687;
  box-shadow: 0 0 18rpx #d4bd7f, 0 0 60rpx rgba(212, 189, 127, 0.6);
  transform: translate(-50%, -50%);
  animation: seed 1.1s ease-out both;
}

.ripple {
  position: absolute;
  top: 50%;
  left: 50%;
  border: 1rpx solid rgba(179, 154, 101, 0.35);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: ripple 1.9s ease-out both;
}

.ripple--two {
  animation-delay: 0.35s;
}

.hexagram {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  flex-direction: column-reverse;
  gap: 12rpx;
  width: 176rpx;
  transform: translate(-50%, -50%);
}

.line {
  width: 100%;
  height: 10rpx;
  border-radius: 8rpx;
  opacity: 0;
  background: linear-gradient(90deg, #856d41, #d8c387, #8f7543);
  animation: line-in 0.42s ease-out forwards;
}

.line--yin {
  display: flex;
  justify-content: space-between;
  background: transparent;
}

.line--yin view {
  width: 43%;
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #856d41, #d8c387);
}

.line--1 { animation-delay: 0.65s; }
.line--2 { animation-delay: 0.82s; }
.line--3 { animation-delay: 0.99s; }
.line--4 { animation-delay: 1.16s; }
.line--5 { animation-delay: 1.33s; }
.line--6 { animation-delay: 1.5s; }

.brand {
  position: absolute;
  top: 58%;
  width: 100%;
  text-align: center;
  opacity: 0;
  animation: brand-in 0.7s 1.55s ease-out forwards;
}

.brand--leaving {
  animation: brand-out 0.25s ease-in forwards;
}

.brand__name {
  color: #eee6d5;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 74rpx;
  letter-spacing: 18rpx;
  text-indent: 18rpx;
}

.brand__rule {
  width: 56rpx;
  height: 2rpx;
  margin: 24rpx auto 20rpx;
  background: #b39a65;
}

.brand__slogan {
  color: rgba(234, 229, 216, 0.54);
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.skip {
  position: absolute;
  top: calc(30rpx + env(safe-area-inset-top));
  right: 28rpx;
  z-index: 5;
  padding: 18rpx 24rpx;
  color: rgba(234, 229, 216, 0.48);
  font-size: 23rpx;
}

.launch--reduced .mist,
.launch--reduced .ripple {
  animation: none;
}

.launch--reduced .line,
.launch--reduced .brand,
.launch--reduced .light-seed {
  opacity: 1;
  animation-duration: 0.01s;
  animation-delay: 0s;
}

@keyframes seed {
  from { opacity: 0; transform: translate(-50%, -180rpx) scale(0.3); }
  60% { opacity: 1; transform: translate(-50%, -50%) scale(1.4); }
  to { transform: translate(-50%, -50%) scale(1); }
}

@keyframes ripple {
  from { width: 20rpx; height: 20rpx; opacity: 0.8; }
  to { width: 340rpx; height: 340rpx; opacity: 0; }
}

@keyframes line-in {
  from { opacity: 0; transform: scaleX(0.1); }
  to { opacity: 1; transform: scaleX(1); }
}

@keyframes brand-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes brand-out {
  to { opacity: 0; transform: translateY(-18rpx); }
}

@keyframes mist-one {
  50% { transform: translateX(52%); }
}

@keyframes mist-two {
  50% { transform: translateX(-48%); }
}

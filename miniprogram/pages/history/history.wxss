.history-page {
  padding-top: 30rpx;
}

.history-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.clear-button {
  padding: 18rpx 12rpx;
  color: rgba(205, 132, 119, 0.72);
  font-size: 22rpx;
}

.history-summary {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 28rpx 24rpx;
}

.history-summary__item {
  min-width: 120rpx;
  text-align: center;
}

.history-summary__number {
  color: #d8c488;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 42rpx;
}

.history-summary__label {
  margin-top: 4rpx;
  color: rgba(234, 229, 216, 0.38);
  font-size: 19rpx;
}

.history-summary__divider {
  width: 1rpx;
  height: 64rpx;
  margin: 0 14rpx;
  background: rgba(234, 229, 216, 0.09);
}

.history-summary__privacy {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: auto;
  color: rgba(102, 132, 122, 0.86);
  font-size: 20rpx;
}

.history-summary__lock {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 1rpx solid rgba(102, 132, 122, 0.4);
  border-radius: 50%;
  font-size: 17rpx;
}

.scope-tabs {
  display: flex;
  gap: 12rpx;
  margin: 26rpx 0;
}

.scope-tab {
  padding: 15rpx 24rpx;
  border-radius: 26rpx;
  color: rgba(234, 229, 216, 0.42);
  font-size: 22rpx;
}

.scope-tab--active {
  color: #d3be86;
  background: rgba(179, 154, 101, 0.12);
}

.history-error {
  padding: 28rpx;
  border: 1rpx solid rgba(154, 79, 68, 0.3);
  border-radius: 20rpx;
  background: rgba(154, 79, 68, 0.07);
}

.history-error__title {
  color: #e8b3ab;
  font-size: 30rpx;
  font-weight: 600;
}

.history-error__text {
  margin-top: 14rpx;
  color: rgba(234, 229, 216, 0.66);
  line-height: 1.7;
}

.history-error__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.history-error__actions .secondary-button,
.history-error__actions .ghost-button {
  flex: 1;
  min-height: 76rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.timeline {
  margin-top: 10rpx;
}

.record-row {
  display: grid;
  grid-template-columns: 82rpx 24rpx 1fr;
  align-items: stretch;
  margin-bottom: 22rpx;
}

.record-date {
  padding-top: 20rpx;
  text-align: right;
}

.record-date__day {
  color: rgba(179, 154, 101, 0.75);
  font-size: 22rpx;
  font-weight: 600;
}

.record-date__year,
.record-date__time {
  margin-top: 4rpx;
  color: rgba(234, 229, 216, 0.28);
  font-size: 17rpx;
}

.timeline__rail {
  position: relative;
}

.timeline__rail::before {
  position: absolute;
  top: 30rpx;
  bottom: -52rpx;
  left: 12rpx;
  width: 1rpx;
  background: rgba(179, 154, 101, 0.16);
  content: "";
}

.record-row:last-child .timeline__rail::before {
  bottom: 30rpx;
}

.timeline__dot {
  position: absolute;
  top: 28rpx;
  left: 7rpx;
  z-index: 2;
  width: 11rpx;
  height: 11rpx;
  border: 3rpx solid #101415;
  border-radius: 50%;
  background: #b39a65;
  box-shadow: 0 0 0 1rpx rgba(179, 154, 101, 0.35);
}

.record-card {
  min-width: 0;
  padding: 22rpx;
}

.record-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-card__mode {
  color: rgba(102, 132, 122, 0.92);
  font-size: 18rpx;
}

.record-card__menu {
  display: flex;
  align-items: center;
}

.record-card__favorite,
.record-card__delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  color: rgba(234, 229, 216, 0.28);
  font-size: 22rpx;
}

.record-card__favorite--active {
  color: #c0a76d;
}

.record-card__delete {
  color: rgba(205, 132, 119, 0.58);
  font-size: 19rpx;
}

.record-card__main {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.record-card__symbol {
  display: flex;
  flex: 0 0 134rpx;
  justify-content: center;
}

.record-card__content {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.record-card__name {
  color: #ece4d5;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 38rpx;
}

.record-card__question {
  display: -webkit-box;
  margin-top: 7rpx;
  overflow: hidden;
  color: rgba(234, 229, 216, 0.45);
  font-size: 20rpx;
  line-height: 1.45;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-card__summary {
  display: -webkit-box;
  margin-top: 18rpx;
  overflow: hidden;
  color: rgba(234, 229, 216, 0.55);
  font-size: 21rpx;
  line-height: 1.6;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-card__open {
  margin-top: 15rpx;
  color: rgba(179, 154, 101, 0.62);
  font-size: 19rpx;
}

.record-card__review {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 13rpx 15rpx;
  border-radius: 12rpx;
  color: rgba(185, 208, 199, 0.8);
  font-size: 19rpx;
  background: rgba(102, 132, 122, 0.1);
}

.record-card__review--due { color: #ead49e; background: rgba(179, 154, 101, 0.14); }
.record-card__review--completed { color: rgba(234, 229, 216, 0.4); }
.record-card__review button { padding: 10rpx 14rpx; color: #b9d0c7; font-size: 18rpx; }

.history-empty {
  padding: 86rpx 30rpx 40rpx;
  text-align: center;
}

.history-empty__rings {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto;
}

.history-empty__rings view {
  position: absolute;
  border: 1rpx solid rgba(179, 154, 101, 0.22);
  border-radius: 50%;
}

.history-empty__rings view:nth-child(1) { inset: 0; }
.history-empty__rings view:nth-child(2) { inset: 24rpx; }
.history-empty__rings view:nth-child(3) {
  inset: 57rpx;
  background: rgba(179, 154, 101, 0.3);
}

.history-empty__title {
  margin-top: 28rpx;
  color: #e6dfd1;
  font-size: 31rpx;
  font-weight: 600;
}

.history-empty__text {
  margin: 14rpx auto 34rpx;
  color: rgba(234, 229, 216, 0.44);
  font-size: 23rpx;
  line-height: 1.65;
}

.history-empty__library {
  width: 100%;
  padding: 24rpx;
  color: rgba(102, 132, 122, 0.9);
  font-size: 22rpx;
}

.home {
  padding-top: 26rpx;
}

.mountain {
  position: absolute;
  right: -80rpx;
  bottom: 0;
  left: -80rpx;
  height: 310rpx;
  opacity: 0.15;
  clip-path: polygon(0 100%, 0 72%, 15% 48%, 26% 68%, 43% 24%, 57% 58%, 69% 38%, 85% 70%, 100% 45%, 100% 100%);
  background: #66847a;
}

.mountain--back {
  bottom: 96rpx;
  opacity: 0.08;
  transform: scaleX(1.18);
  animation: mountain-breathe 9s ease-in-out infinite;
}

.mountain--front {
  background: #263532;
}

.home--quiet .mountain,
.home--quiet .ink-orb,
.home--quiet .hero__halo {
  animation: none;
}

.home__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home__title {
  margin-top: 6rpx;
  color: #f1e9d9;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 52rpx;
  letter-spacing: 8rpx;
}

.settings-button {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(234, 229, 216, 0.13);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.025);
}

.settings-button__ring {
  position: absolute;
  inset: 20rpx;
  border: 3rpx dotted rgba(179, 154, 101, 0.78);
  border-radius: 50%;
}

.settings-button__dot {
  position: absolute;
  top: 31rpx;
  left: 31rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c2aa72;
}

.hero {
  position: relative;
  min-height: 360rpx;
  margin-top: 44rpx;
  padding: 42rpx 34rpx 32rpx;
  overflow: hidden;
}

.hero::before {
  position: absolute;
  top: -10rpx;
  right: -80rpx;
  width: 330rpx;
  height: 330rpx;
  border: 1rpx solid rgba(179, 154, 101, 0.12);
  border-radius: 50%;
  content: "";
}

.hero__halo {
  position: absolute;
  top: -90rpx;
  right: -35rpx;
  width: 310rpx;
  height: 310rpx;
  border-radius: 50%;
  opacity: 0.5;
  background: radial-gradient(circle, rgba(198, 174, 117, 0.2), transparent 65%);
  animation: halo 5s ease-in-out infinite;
}

.hero__date {
  position: relative;
  color: #bfa76e;
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.hero__copy {
  position: relative;
  max-width: 520rpx;
  margin-top: 22rpx;
  color: rgba(238, 232, 218, 0.75);
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 34rpx;
  line-height: 1.6;
}

.hero__action {
  position: absolute;
  right: 26rpx;
  bottom: 26rpx;
  left: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(179, 154, 101, 0.22);
  border-radius: 24rpx;
  text-align: left;
  background: rgba(8, 12, 13, 0.28);
}

.hero__action-title {
  color: #eee6d6;
  font-size: 29rpx;
  font-weight: 600;
}

.hero__action-note {
  margin-top: 8rpx;
  color: rgba(234, 229, 216, 0.44);
  font-size: 21rpx;
}

.hero__arrow {
  color: #c3aa72;
  font-size: 42rpx;
}

.ask-card {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 22rpx;
  padding: 28rpx 28rpx;
  border: 1rpx solid rgba(102, 132, 122, 0.34);
  border-radius: 26rpx;
  text-align: left;
  background: linear-gradient(120deg, rgba(102, 132, 122, 0.2), rgba(27, 35, 35, 0.75));
}

.ask-card__seal {
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(179, 154, 101, 0.4);
  border-radius: 18rpx;
  color: #c2a86f;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 38rpx;
}

.ask-card__body {
  flex: 1;
  margin-left: 22rpx;
}

.ask-card__title {
  color: #eee7d8;
  font-size: 30rpx;
  font-weight: 600;
}

.ask-card__text {
  margin-top: 7rpx;
  color: rgba(234, 229, 216, 0.48);
  font-size: 22rpx;
}

.ask-card__arrow {
  color: rgba(179, 154, 101, 0.82);
  font-size: 36rpx;
}

.wisdom-preview {
  width: 100%;
  margin-top: 22rpx;
  padding: 27rpx 28rpx;
  border: 1rpx solid rgba(179, 154, 101, 0.2);
  border-radius: 26rpx;
  text-align: left;
  background: linear-gradient(135deg, rgba(49, 51, 43, 0.78), rgba(22, 29, 29, 0.9));
}

.wisdom-preview__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.wisdom-preview__label {
  color: #bca46c;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.wisdom-preview__more {
  flex: none;
  color: rgba(234, 229, 216, 0.34);
  font-size: 19rpx;
}

.wisdom-preview__title {
  margin-top: 16rpx;
  color: #eee6d7;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 36rpx;
}

.wisdom-preview__principle {
  margin-top: 9rpx;
  color: rgba(234, 229, 216, 0.57);
  font-size: 23rpx;
  line-height: 1.55;
}

.wisdom-preview__action {
  margin-top: 17rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid rgba(234, 229, 216, 0.08);
  color: #9fafaa;
  font-size: 21rpx;
  line-height: 1.55;
}

.path-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.path-card {
  min-height: 228rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(234, 229, 216, 0.1);
  border-radius: 25rpx;
  text-align: left;
  background: rgba(24, 31, 31, 0.76);
}

.path-card__visual {
  position: relative;
  width: 86rpx;
  height: 76rpx;
}

.mini-line {
  width: 84rpx;
  height: 8rpx;
  margin-bottom: 11rpx;
  border-radius: 8rpx;
  background: #b39a65;
}

.mini-line--yin {
  display: flex;
  justify-content: space-between;
  background: transparent;
}

.mini-line--yin view {
  width: 36rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #b39a65;
}

.orbit {
  position: absolute;
  inset: 2rpx 10rpx 6rpx 4rpx;
  border: 1rpx solid rgba(102, 132, 122, 0.8);
  border-radius: 50%;
  transform: rotate(-20deg);
}

.orbit::after {
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(179, 154, 101, 0.48);
  border-radius: 50%;
  content: "";
}

.orbit-dot {
  position: absolute;
  top: 3rpx;
  right: 13rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #b39a65;
  box-shadow: 0 0 14rpx rgba(179, 154, 101, 0.55);
}

.path-card__title {
  margin-top: 18rpx;
  color: #eae4d7;
  font-size: 28rpx;
  font-weight: 600;
}

.path-card__meta {
  margin-top: 8rpx;
  color: rgba(234, 229, 216, 0.42);
  font-size: 21rpx;
}

.home__footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 58rpx 0 14rpx;
  color: rgba(234, 229, 216, 0.3);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.review-alert {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 18rpx;
  padding: 22rpx;
  text-align: left;
  background: rgba(102, 132, 122, 0.1);
}

.review-alert__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid rgba(102, 132, 122, 0.45);
  border-radius: 50%;
  color: #b9d0c7;
}

.review-alert__body { flex: 1; margin-left: 18rpx; }
.review-alert__title { color: #e8e1d3; font-size: 25rpx; }
.review-alert__text { margin-top: 5rpx; color: rgba(234, 229, 216, 0.45); font-size: 20rpx; }
.review-alert__arrow { color: #8eaa9f; font-size: 28rpx; }

.path-card__visual--support {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(179, 154, 101, 0.85);
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 48rpx;
}

.home__footer-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 1rpx solid rgba(154, 79, 68, 0.42);
  color: rgba(202, 116, 102, 0.58);
  font-family: "STKaiti", "KaiTi", serif;
}

.daily-overlay {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(4, 7, 8, 0.76);
  backdrop-filter: blur(12rpx);
}

.daily-sheet {
  width: 100%;
  padding: 18rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(179, 154, 101, 0.28);
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(155deg, #202a29, #111718);
  animation: sheet-up 240ms ease-out;
}

.daily-sheet__handle {
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 34rpx;
  border-radius: 6rpx;
  background: rgba(234, 229, 216, 0.18);
}

.daily-sheet__eyebrow {
  color: #b39a65;
  font-size: 21rpx;
  letter-spacing: 6rpx;
}

.daily-sheet__title {
  margin-top: 10rpx;
  color: #efe8d9;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 42rpx;
}

.daily-sheet__note {
  margin-top: 12rpx;
  color: rgba(234, 229, 216, 0.5);
  font-size: 23rpx;
}

.state-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.state-card {
  min-height: 118rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(234, 229, 216, 0.1);
  border-radius: 20rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.025);
}

.state-card__name {
  color: #e8e1d3;
  font-size: 28rpx;
  font-weight: 600;
}

.state-card__note {
  margin-top: 8rpx;
  color: rgba(234, 229, 216, 0.42);
  font-size: 20rpx;
  line-height: 1.35;
}

.daily-sheet__cancel {
  width: 100%;
  margin-top: 15rpx;
  padding: 22rpx;
  color: rgba(234, 229, 216, 0.42);
  font-size: 23rpx;
}

@keyframes halo {
  50% { opacity: 0.85; transform: scale(1.12); }
}

@keyframes mountain-breathe {
  50% { transform: scaleX(1.22) translateY(12rpx); }
}

@keyframes sheet-up {
  from { transform: translateY(80rpx); opacity: 0; }
}

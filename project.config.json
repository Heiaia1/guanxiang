{
  "description": "观象录微信小程序：传统文化互动与个人反思工具",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "scripts"
      }
    ]
  },
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "preloadBackgroundData": false,
    "minified": true,
    "newFeature": true,
    "coverView": true,
    "nodeModules": false,
    "autoAudits": false,
    "showShadowRootInWxmlPanel": true,
    "scopeDataCheck": false,
    "uglifyFileName": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "compileHotReLoad": true,
    "useMultiFrameRuntime": true,
    "useApiHook": true,
    "useApiHostProcess": true,
    "useIsolateContext": true,
    "useCompilerModule": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "useCompilerPlugins": [
      "typescript"
    ]
  },
  "compileType": "miniprogram",
  "libVersion": "trial",
  "appid": "touristappid",
  "projectname": "guanxiang-miniapp",
  "miniprogramRoot": "miniprogram/",
  "simulatorType": "wechat",
  "condition": {}
}
